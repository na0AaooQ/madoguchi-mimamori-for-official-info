{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:madoguchi-mimamori:schema:locale:cards:1.0.0",
  "title": "Locale 案内カード",
  "description": "日本語と英語で共有する案内カード表示文言のSchemaです。",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "data_updated_on": {
      "type": "string",
      "format": "date"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^card-[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "region_label": {
            "type": "string",
            "minLength": 1
          },
          "emergency_note": {
            "type": "string",
            "minLength": 1
          },
          "details_label": {
            "type": "string",
            "minLength": 1
          },
          "locale_status": {
            "type": "string",
            "enum": ["draft", "under-review", "published", "needs-update", "archived"]
          },
          "content_revision": {
            "type": "integer",
            "minimum": 1
          },
          "based_on_ja_revision": {
            "type": "integer",
            "minimum": 1
          },
          "content_reviewed_on": {
            "type": "string",
            "format": "date"
          }
        },
        "required": ["id", "title", "summary", "locale_status", "content_revision"],
        "if": {
          "properties": {
            "locale_status": {
              "const": "published"
            }
          },
          "required": ["locale_status"]
        },
        "then": {
          "properties": {
            "content_reviewed_on": true
          },
          "required": ["content_reviewed_on"]
        },
        "additionalProperties": false
      }
    }
  },
  "required": ["schema_version", "data_updated_on", "items"],
  "additionalProperties": false
}
