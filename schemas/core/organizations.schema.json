{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:madoguchi-mimamori:schema:core:organizations:1.0.0",
  "title": "Core 団体",
  "description": "団体の区分、対象地域、公開状態を管理するSchemaです。",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "data_updated_on": {
      "type": "string",
      "format": "date"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^org-[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "organization_type": {
            "type": "string",
            "enum": [
              "national-government",
              "local-government",
              "police",
              "fire-service",
              "public-medical-service",
              "utility-operator",
              "telecommunications-operator",
              "transport-operator",
              "related-public-organization",
              "other-public-service-operator"
            ]
          },
          "region_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^region-[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "parent_organization_id": {
            "type": "string",
            "pattern": "^org-[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "publication_status": {
            "type": "string",
            "enum": ["draft", "under-review", "published", "hidden", "archived"]
          },
          "internal_note": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["id", "organization_type", "region_ids", "publication_status"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema_version", "data_updated_on", "items"],
  "additionalProperties": false
}
