{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:madoguchi-mimamori:schema:core:regions:1.0.0",
  "title": "Core 地域",
  "description": "地域の階層と公開状態を管理するSchemaです。",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "data_updated_on": {
      "type": "string",
      "format": "date"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^region-[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "region_type": {
            "type": "string",
            "enum": ["country", "nationwide", "prefecture", "municipality", "service-area"]
          },
          "region_slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "display_order": {
            "type": "integer",
            "minimum": 1
          },
          "parent_region_id": {
            "type": "string",
            "pattern": "^region-[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "official_code": {
            "type": "string",
            "minLength": 1
          },
          "publication_status": {
            "type": "string",
            "enum": ["draft", "under-review", "published", "hidden", "archived"]
          },
          "internal_note": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["id", "region_type", "publication_status"],
        "allOf": [
          {
            "if": {
              "properties": { "region_type": { "const": "prefecture" } },
              "required": ["region_type"]
            },
            "then": {
              "properties": { "region_slug": {}, "display_order": {} },
              "required": ["region_slug", "display_order"]
            }
          },
          {
            "if": {
              "properties": { "region_type": { "not": { "const": "prefecture" } } },
              "required": ["region_type"]
            },
            "then": {
              "not": {
                "anyOf": [{ "required": ["region_slug"] }, { "required": ["display_order"] }]
              }
            }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema_version", "data_updated_on", "items"],
  "additionalProperties": false
}
