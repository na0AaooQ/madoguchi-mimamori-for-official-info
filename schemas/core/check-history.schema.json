{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:madoguchi-mimamori:schema:core:check-history:1.0.0",
  "title": "Core 内部確認履歴",
  "description": "内部確認履歴の未実装データを空配列として管理するSchemaです。",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "data_updated_on": {
      "type": "string",
      "format": "date"
    },
    "items": {
      "type": "array",
      "maxItems": 0
    }
  },
  "required": ["schema_version", "data_updated_on", "items"],
  "additionalProperties": false
}
